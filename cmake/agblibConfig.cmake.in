# find_package(agblib) reads this file. The file finds ntdlib first, and seqlib if agblib was built with
# AGBLIB_SEQUENCE_EXPORT. agblib's targets come last. AGBLIB_SEQUENCE_EXPORT keeps the value that agblib was built with,
# for a consumer to read.

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(AGBLIB_SEQUENCE_EXPORT @AGBLIB_SEQUENCE_EXPORT@)

find_dependency(ntdlib 4.0)
if (AGBLIB_SEQUENCE_EXPORT)
    find_dependency(seqlib 1.4)
endif()

include(${CMAKE_CURRENT_LIST_DIR}/agblibTargets.cmake)
check_required_components(agblib)
